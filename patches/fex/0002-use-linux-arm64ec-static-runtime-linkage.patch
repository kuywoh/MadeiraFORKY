diff --git a/Source/Windows/ARM64EC/CMakeLists.txt b/Source/Windows/ARM64EC/CMakeLists.txt
--- a/Source/Windows/ARM64EC/CMakeLists.txt
+++ b/Source/Windows/ARM64EC/CMakeLists.txt
@@ -15,7 +15,6 @@
 target_link_libraries(arm64ecfex PRIVATE
   FEXCore_Base
   Common
   CommonTools
   CommonWindows
-  CommonWindowsRuntime
   ntdll_ex)
@@ -29,9 +28,36 @@
 # For our iOS-host build, fall through to the default mingw link rules —
 # they include the right startup files, CRT, and produce a clean arm64ec PE.
 # The resulting DLL is slightly larger but links cleanly.
 if (FEX_IOS_HOST_BUILD)
   target_link_options(arm64ecfex PRIVATE -static)
+  if (CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
+    # Pull the FEX WinAPI wrappers in alongside the COFF archive's EC symbol map.
+    target_link_libraries(arm64ecfex PRIVATE
+      -Wl,--whole-archive
+      CommonWindowsRuntime
+      -Wl,--no-whole-archive)
+  endif()
+  if (CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
+    set(LLVM_MINGW_ARM64EC_LIB_DIR "$ENV{LLVM_MINGW_BIN}/../arm64ec-w64-mingw32/lib")
+    foreach(runtime libc++.a libc++abi.a libunwind.a)
+      if (NOT EXISTS "${LLVM_MINGW_ARM64EC_LIB_DIR}/${runtime}")
+        message(FATAL_ERROR "Missing ARM64EC runtime library: ${LLVM_MINGW_ARM64EC_LIB_DIR}/${runtime}")
+      endif()
+    endforeach()
+    if (NOT EXISTS "${LLVM_MINGW_ARM64EC_LIB_DIR}/objects/cxa_personality.cpp.obj")
+      message(FATAL_ERROR "Missing extracted ARM64EC C++ personality object")
+    endif()
+    target_sources(arm64ecfex PRIVATE "${LLVM_MINGW_ARM64EC_LIB_DIR}/objects/cxa_personality.cpp.obj")
+    target_link_libraries(arm64ecfex PRIVATE
+      -Wl,--whole-archive
+      "${LLVM_MINGW_ARM64EC_LIB_DIR}/libc++.a"
+      -Wl,--no-whole-archive
+      "${LLVM_MINGW_ARM64EC_LIB_DIR}/libc++abi.a"
+      "${LLVM_MINGW_ARM64EC_LIB_DIR}/libunwind.a"
+    )
+  endif()
 else()
   target_link_options(arm64ecfex PRIVATE -static -nostdlib -nostartfiles -nodefaultlibs -lc++ -lc++abi -lunwind)
   target_link_libraries(arm64ecfex PRIVATE ${LIBGCC_PATH})
 endif()
